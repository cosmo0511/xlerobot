+@TeleoperatorConfig.register_subclass("bi_so_base_leader")
+@dataclass
+class BiSOBaseLeaderConfig(TeleoperatorConfig):
+    """Bimanual SO leader arms plus keyboard control of a 3-omniwheel base.

+    port_zmq_observations: int = 5556
+
+    connection_time_s: int = 0
+    watchdog_timeout_ms: int = 500
+    max_loop_freq_hz: int = 30
+    observation_freq_hz: int = 30
+
+
+@RobotConfig.register_subclass("bi_so_base_client")
+@dataclass
+class BiSOBaseClientConfig(RobotConfig):
+    """Client-side (laptop/PC) settings for the bimanual SO follower with base.
+
+    `cameras` does NOT open any device here: the client only decodes JPEG frames
+    pushed by the host. The entries declare the expected keys and resolutions, so
+    the names and width/height must match the host configuration.
+    """
+
+    remote_ip: str
+    port_zmq_cmd: int = 5555
+    port_zmq_observations: int = 5556
+
+    polling_timeout_ms: int = 15
+    connect_timeout_s: int = 5
+
+    cameras: dict[str, CameraConfig] = field(default_factory=dict)
+
+    teleop_keys: dict[str, str] = field(
+        default_factory=lambda: {
+            "forward": "w",
+            "backward": "s",
+            "left": "a",
+            "right": "d",
+            "rotate_left": "z",

+
+# ──────────────────────────────────────────────────────────────────────────
+# Bimanual SO follower with a 3-omniwheel mobile base (LeKiwi-style).
+#
+# The three base wheels (IDs 7/8/9) share the RIGHT arm's serial bus, so no
+# extra adapter is needed. Arm motors run in position mode, wheels in velocity
+# mode, and the two groups are read and written separately.
+# ──────────────────────────────────────────────────────────────────────────
+
+
+@RobotConfig.register_subclass("bi_so_base_follower")
+@dataclass
+class BiSOBaseFollowerConfig(RobotConfig):
+    """Bimanual SO follower plus a 3-omniwheel base on the right arm's bus."""

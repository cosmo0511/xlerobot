+
+"""Bimanual SO follower with a 3-omniwheel mobile base.
+
+The base wheels share the RIGHT arm's serial bus (IDs 7/8/9), so the robot needs
+no extra USB adapter. Arm motors stay in position mode and are read as
+``Present_Position``; wheels run in velocity mode and are read as
+``Present_Velocity``, then converted to body-frame ``x/y/theta`` velocities.
+
+Observation and action are 15-dimensional:
+    left_*.pos  (6) + right_*.pos (6) + x.vel, y.vel, theta.vel (3)
+
+The kinematics are the same as LeKiwi's: three omniwheels mounted at 240/0/120
+degrees with a -90 degree offset.
+"""
+
+import logging
+from functools import cached_property
+from typing import Any
+
+import numpy as np
+
+from lerobot.motors import Motor, MotorCalibration, MotorNormMode
+from lerobot.motors.feetech import OperatingMode
+from lerobot.types import RobotAction, RobotObservation
+from lerobot.utils.decorators import check_if_not_connected
+
+from .bi_so_follower import BiSOFollower
+from .config_bi_so_follower import BiSOBaseFollowerConfig
+
+logger = logging.getLogger(__name__)
+
+# Wheel geometry. Adjust to match the physical base.
+WHEEL_RADIUS = 0.05  # m
+BASE_RADIUS = 0.125  # m, centre of rotation to each wheel
+WHEEL_ANGLES_DEG = (240.0, 0.0, 120.0)  # mounting angles, -90 offset applied below
+MAX_RAW = 3000  # per-wheel raw speed cap
+
+BASE_MOTORS: dict[str, Motor] = {
+    "base_left_wheel": Motor(7, "sts3215", MotorNormMode.RANGE_M100_100),
+    "base_back_wheel": Motor(8, "sts3215", MotorNormMode.RANGE_M100_100),
+    "base_right_wheel": Motor(9, "sts3215", MotorNormMode.RANGE_M100_100),
+}
+
+BASE_FEATURES = ("x.vel", "y.vel", "theta.vel")
+
+
+def _add_motors_to_bus(bus, motors: dict[str, Motor]) -> None:
+    """Register extra motors on an already-constructed bus.
+
+    `MotorsBus.__init__` builds id lookup tables and caches `models`/`ids` from
+    the motor dict, so adding entries afterwards requires rebuilding them.
+    Without this, reads on the new ids raise `KeyError`.
+    """
+    bus.motors.update(motors)
+
+    bus._id_to_model_dict = {m.id: m.model for m in bus.motors.values()}
+    bus._id_to_name_dict = {m.id: name for name, m in bus.motors.items()}
+
+    # `models` and `ids` are cached_property; drop them so they recompute.
+    for cached in ("models", "ids", "_has_different_ctrl_tables"):
+        bus.__dict__.pop(cached, None)
+
+    bus._validate_motors()
+
+
+class BiSOBaseFollower(BiSOFollower):
+    """Bimanual SO follower whose right-arm bus also carries three base wheels."""
+
+    config_class = BiSOBaseFollowerConfig
+    name = "bi_so_base_follower"
+
+    def __init__(self, config: BiSOBaseFollowerConfig):
+        super().__init__(config)
+        self.config = config
+
+        # Motors the right arm owns, before the wheels join its bus.
+        self.right_arm_motors = list(self.right_arm.bus.motors)
+
+        # The wheels live on the right arm's bus; declare them so the bus will
+        # talk to IDs 7/8/9 as well.
+        self.base_motors = list(BASE_MOTORS)
+        _add_motors_to_bus(self.right_arm.bus, BASE_MOTORS)
+
+    # ── features ──────────────────────────────────────────────────────────
+
+    @property
+    def _motors_ft(self) -> dict[str, type]:
+        arm_ft = {
+            **{f"left_{k}": v for k, v in self.left_arm._motors_ft.items()},
+            **{f"right_{k}": v for k, v in self.right_arm._motors_ft.items()},
+        }
+        return {**arm_ft, **dict.fromkeys(BASE_FEATURES, float)}
+
+    @cached_property
+    def observation_features(self) -> dict[str, type | tuple]:
+        return {**self._motors_ft, **self._cameras_ft}
+
+    @cached_property
+    def action_features(self) -> dict[str, type]:
+        return self._motors_ft
+
+    # ── lifecycle ─────────────────────────────────────────────────────────
+
+    def connect(self, calibrate: bool = True) -> None:
+        """Connect both arms, then put the wheels back into velocity mode.
+
+        `SOFollower.connect()` runs its own `configure()`, which walks every
+        motor on its bus and writes POSITION mode. The wheels now live on the
+        right arm's bus, so they get caught by that loop and stop responding to
+        `Goal_Velocity`. Re-apply velocity mode after the arms are up.
+        """
+        super().connect(calibrate)
+        self._configure_base()
+
+    def _configure_base(self) -> None:
+        """Put the three wheels into velocity mode."""
+        bus = self.right_arm.bus
+        bus.disable_torque(self.base_motors)
+        for name in self.base_motors:
+            bus.write("Operating_Mode", name, OperatingMode.VELOCITY.value)
+        bus.enable_torque(self.base_motors)
+        logger.info("Base wheels set to velocity mode: %s", ", ".join(self.base_motors))
+
+    def configure(self) -> None:
+        """Arms in position mode, wheels in velocity mode."""
+        self.left_arm.configure()
+
+        bus = self.right_arm.bus
+        bus.disable_torque()
+        bus.configure_motors()
+        for name in self.right_arm_motors:
+            bus.write("Operating_Mode", name, OperatingMode.POSITION.value)
+            bus.write("P_Coefficient", name, 16)
+            bus.write("I_Coefficient", name, 0)
+            bus.write("D_Coefficient", name, 32)
+            if name.endswith("gripper"):
+                bus.write("Max_Torque_Limit", name, 500)
+                bus.write("Protection_Current", name, 250)
+                bus.write("Overload_Torque", name, 25)
+
+        bus.enable_torque()
+        self._configure_base()
+
+    def calibrate(self) -> None:
+        """Calibrate both arms, then give the wheels a pass-through calibration.
+
+        Wheels spin continuously, so they get homing offset 0 and the full
+        0..4095 range instead of a measured range of motion.
+        """
+        self.left_arm.calibrate()
+        self.right_arm.calibrate()
+
+        bus = self.right_arm.bus
+        wheel_calib = {
+            name: MotorCalibration(
+                id=BASE_MOTORS[name].id,
+                drive_mode=0,
+                homing_offset=0,
+                range_min=0,
+                range_max=4095,
+            )
+            for name in self.base_motors
+        }
+        bus.calibration.update(wheel_calib)
+        bus.write_calibration(wheel_calib)
+        logger.info("Base wheels calibrated (pass-through: offset 0, range 0-4095)")
+
+    def setup_motors(self) -> None:
+        super().setup_motors()
+        for motor in reversed(self.base_motors):
+            input(f"Connect the controller board to the '{motor}' motor only and press enter.")
+            self.right_arm.bus.setup_motor(motor)
+
+    # ── data ──────────────────────────────────────────────────────────────
+
+    @check_if_not_connected
+    def get_observation(self) -> RobotObservation:
+        obs_dict: RobotObservation = {}
+
+        for key, value in self.left_arm.get_observation().items():
+            obs_dict[key if key in self._top_level_cam_keys else f"left_{key}"] = value
+
+        # The right arm's own get_observation() would also read the wheels as
+        # positions, so read its motors explicitly instead.
+        bus = self.right_arm.bus
+        arm_pos = bus.sync_read("Present_Position", self.right_arm_motors)
+        for key, value in arm_pos.items():
+            obs_dict[f"right_{key}.pos"] = value
+        for cam_key, cam in self.right_arm.cameras.items():
+            obs_dict[f"right_{cam_key}"] = cam.read_latest()
+
+        wheel_vel = bus.sync_read("Present_Velocity", self.base_motors)
+        obs_dict.update(
+            self._wheel_raw_to_body(
+                wheel_vel["base_left_wheel"],
+                wheel_vel["base_back_wheel"],
+                wheel_vel["base_right_wheel"],
+            )
+        )
+
+        return obs_dict
+
+    @check_if_not_connected
+    def send_action(self, action: RobotAction) -> RobotAction:
+        left_action = {
+            k.removeprefix("left_"): v for k, v in action.items() if k.startswith("left_")
+        }
+        right_action = {
+            k.removeprefix("right_"): v for k, v in action.items() if k.startswith("right_")
+        }
+        base_action = {k: float(action.get(k, 0.0)) for k in BASE_FEATURES}
+
+        sent_left = self.left_arm.send_action(left_action)
+
+        # Right arm: write positions only to the arm motors on that bus.
+        arm_goal = {k.replace(".pos", ""): v for k, v in right_action.items() if k.endswith(".pos")}
+        arm_goal = {k: v for k, v in arm_goal.items() if k in self.right_arm_motors}
+        bus = self.right_arm.bus
+        if arm_goal:
+            bus.sync_write("Goal_Position", arm_goal)
+
+        wheel_goal = self._body_to_wheel_raw(
+            base_action["x.vel"], base_action["y.vel"], base_action["theta.vel"]
+        )
+        bus.sync_write("Goal_Velocity", wheel_goal)
+
+        sent = {f"left_{k}": v for k, v in sent_left.items()}
+        sent.update({f"right_{k}.pos": v for k, v in arm_goal.items()})
+        sent.update(base_action)
+        return sent
+
+    def stop_base(self) -> None:
+        self.right_arm.bus.sync_write(
+            "Goal_Velocity", dict.fromkeys(self.base_motors, 0), num_retry=5
+        )
+        logger.info("Base motors stopped")
+
+    def disconnect(self) -> None:
+        if self.is_connected:
+            try:
+                self.stop_base()
+            except Exception as exc:  # noqa: BLE001 - best effort on shutdown
+                logger.warning("Could not stop base motors: %s", exc)
+        super().disconnect()
+
+    # ── kinematics (3 omniwheels) ─────────────────────────────────────────
+
+    @staticmethod
+    def _degps_to_raw(degps: float) -> int:
+        speed_int = int(round(degps * (4096.0 / 360.0)))
+        return max(-0x8000, min(0x7FFF, speed_int))
+
+    @staticmethod
+    def _raw_to_degps(raw_speed: int) -> float:
+        return raw_speed / (4096.0 / 360.0)
+
+    @staticmethod
+    def _wheel_matrix() -> np.ndarray:
+        angles = np.radians(np.array(WHEEL_ANGLES_DEG) - 90.0)
+        return np.array([[np.cos(a), np.sin(a), BASE_RADIUS] for a in angles])
+
+    def _body_to_wheel_raw(self, x: float, y: float, theta: float) -> dict[str, int]:
+        """Body velocities (m/s, m/s, deg/s) -> per-wheel raw speed."""
+        velocity = np.array([x, y, theta * (np.pi / 180.0)])
+        wheel_degps = (self._wheel_matrix().dot(velocity) / WHEEL_RADIUS) * (180.0 / np.pi)
+
+        steps_per_deg = 4096.0 / 360.0
+        peak = max(abs(d) * steps_per_deg for d in wheel_degps)
+        if peak > MAX_RAW:
+            wheel_degps = wheel_degps * (MAX_RAW / peak)
+
+        raw = [self._degps_to_raw(d) for d in wheel_degps]
+        return {
+            "base_left_wheel": raw[0],
+            "base_back_wheel": raw[1],
+            "base_right_wheel": raw[2],
+        }
+
+    def _wheel_raw_to_body(
+        self, left_speed: int, back_speed: int, right_speed: int
+    ) -> dict[str, Any]:
+        """Per-wheel raw speed -> body velocities (m/s, m/s, deg/s)."""
+        wheel_degps = np.array(
+            [
+                self._raw_to_degps(left_speed),
+                self._raw_to_degps(back_speed),
+                self._raw_to_degps(right_speed),
+            ]
+        )
+        wheel_linear = wheel_degps * (np.pi / 180.0) * WHEEL_RADIUS
+        x, y, theta_rad = np.linalg.inv(self._wheel_matrix()).dot(wheel_linear)
+        return {"x.vel": float(x), "y.vel": float(y), "theta.vel": float(theta_rad * 180.0 / np.pi)}

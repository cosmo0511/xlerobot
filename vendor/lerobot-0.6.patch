@@ -0,0 +1,199 @@
+#!/usr/bin/env python
+
+# Copyright 2026 The HuggingFace Inc. team. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Bimanual SO leader arms plus keyboard control of a 3-omniwheel base.
+
+`lerobot-record` and `lerobot-teleoperate` accept exactly one teleoperator on
+the command line, so driving the arms and the base at the same time needs them
+combined into a single device. This class holds a `BiSOLeader` and a
+`KeyboardTeleop`, and returns one 15-dimensional action:
+
+    left_*.pos (6) + right_*.pos (6) + x.vel, y.vel, theta.vel (3)
+
+Because the base velocities travel in the same action dict as the arm
+positions, they are recorded into the dataset like any other dimension.
+"""
+
+import logging
+import os
+from functools import cached_property
+from typing import Any
+
+from lerobot.teleoperators.keyboard import KeyboardTeleop
+from lerobot.teleoperators.keyboard.configuration_keyboard import KeyboardTeleopConfig
+from lerobot.types import RobotAction
+from lerobot.utils.decorators import check_if_already_connected, check_if_not_connected
+
+from ..teleoperator import Teleoperator
+from .bi_so_leader import BiSOLeader
+from .config_bi_so_leader import BiSOBaseLeaderConfig, BiSOLeaderConfig
+
+logger = logging.getLogger(__name__)
+
+# Set LEROBOT_DEBUG_KEYS=1 to log every keyboard poll.
+DEBUG_KEYS = os.environ.get("LEROBOT_DEBUG_KEYS") == "1"
+
+BASE_FEATURES = ("x.vel", "y.vel", "theta.vel")
+
+# Base speed presets, cycled with the speed_up / speed_down keys.
+SPEED_LEVELS = (
+    {"xy": 0.1, "theta": 30.0},
+    {"xy": 0.25, "theta": 60.0},
+    {"xy": 0.4, "theta": 90.0},
+)
+
+
+class BiSOBaseLeader(Teleoperator):
+    """Two SO leader arms and a keyboard, presented as one teleoperator."""
+
+    config_class = BiSOBaseLeaderConfig
+    name = "bi_so_base_leader"
+
+    def __init__(self, config: BiSOBaseLeaderConfig):
+        super().__init__(config)
+        self.config = config
+
+        self.arms = BiSOLeader(
+            BiSOLeaderConfig(
+                id=config.id,
+                calibration_dir=config.calibration_dir,
+                left_arm_config=config.left_arm_config,
+                right_arm_config=config.right_arm_config,
+            )
+        )
+        self.keyboard = KeyboardTeleop(KeyboardTeleopConfig(id=f"{config.id}_keyboard" if config.id else None))
+
+        self.teleop_keys = config.teleop_keys
+        self.speed_levels = SPEED_LEVELS
+        self.speed_index = 0
+
+        # The keyboard listener is global: anything typed anywhere reaches it,
+        # including a chat window or another terminal. Start locked so a stray
+        # "wasd" cannot drive the robot, and require an explicit toggle.
+        self.base_armed = not config.base_locked_on_start
+        self._arm_key = config.arm_key
+        self._arm_latch = False
+
+    # ── features ──────────────────────────────────────────────────────────
+
+    @cached_property
+    def action_features(self) -> dict[str, type]:
+        return {**self.arms.action_features, **dict.fromkeys(BASE_FEATURES, float)}
+
+    @cached_property
+    def feedback_features(self) -> dict[str, type]:
+        return {}
+
+    # ── lifecycle ─────────────────────────────────────────────────────────
+
+    @property
+    def is_connected(self) -> bool:
+        return self.arms.is_connected and self.keyboard.is_connected
+
+    @check_if_already_connected
+    def connect(self, calibrate: bool = True) -> None:
+        self.arms.connect(calibrate)
+        self.keyboard.connect()
+        logger.info(
+            "%s connected. Base keys: %s",
+            self,
+            ", ".join(f"{k}={v}" for k, v in self.teleop_keys.items()),
+        )
+        logger.info(
+            "Base is %s. Press '%s' to toggle.",
+            "ARMED" if self.base_armed else "LOCKED",
+            self._arm_key,
+        )
+
+    @property
+    def is_calibrated(self) -> bool:
+        return self.arms.is_calibrated
+
+    def calibrate(self) -> None:
+        self.arms.calibrate()
+
+    def configure(self) -> None:
+        self.arms.configure()
+        self.keyboard.configure()
+
+    @check_if_not_connected
+    def disconnect(self) -> None:
+        self.arms.disconnect()
+        self.keyboard.disconnect()
+
+    # ── data ──────────────────────────────────────────────────────────────
+
+    @check_if_not_connected
+    def get_action(self) -> RobotAction:
+        action = self.arms.get_action()
+        pressed = self.keyboard.get_action()
+        base = self._keys_to_base_action(pressed)
+        if DEBUG_KEYS:
+            logger.info(
+                "keyboard: listener_alive=%s pressed=%s -> %s",
+                self.keyboard.is_connected,
+                sorted(str(k) for k in pressed) or "-",
+                base,
+            )
+        action.update(base)
+        return action
+
+    def _keys_to_base_action(self, pressed_keys) -> dict[str, float]:
+        """Turn the currently pressed keys into body-frame base velocities.
+
+        Returns all zeros while the base is locked, so typing elsewhere cannot
+        move the robot.
+        """
+        # Toggle on the key's rising edge only, so holding it does not flap.
+        arm_held = self._arm_key in pressed_keys
+        if arm_held and not self._arm_latch:
+            self.base_armed = not self.base_armed
+            logger.info("Base %s", "ARMED" if self.base_armed else "LOCKED")
+        self._arm_latch = arm_held
+
+        if not self.base_armed:
+            return {"x.vel": 0.0, "y.vel": 0.0, "theta.vel": 0.0}
+
+        if self.teleop_keys["speed_up"] in pressed_keys:
+            self.speed_index = min(self.speed_index + 1, len(self.speed_levels) - 1)
+        if self.teleop_keys["speed_down"] in pressed_keys:
+            self.speed_index = max(self.speed_index - 1, 0)
+
+        speed = self.speed_levels[self.speed_index]
+        xy_speed = speed["xy"]
+        theta_speed = speed["theta"]
+
+        x_cmd = 0.0  # m/s, forward positive
+        y_cmd = 0.0  # m/s, left positive
+        theta_cmd = 0.0  # deg/s, counter-clockwise positive
+
+        if self.teleop_keys["forward"] in pressed_keys:
+            x_cmd += xy_speed
+        if self.teleop_keys["backward"] in pressed_keys:
+            x_cmd -= xy_speed
+        if self.teleop_keys["left"] in pressed_keys:
+            y_cmd += xy_speed
+        if self.teleop_keys["right"] in pressed_keys:
+            y_cmd -= xy_speed
+        if self.teleop_keys["rotate_left"] in pressed_keys:
+            theta_cmd += theta_speed
+        if self.teleop_keys["rotate_right"] in pressed_keys:
+            theta_cmd -= theta_speed
+
+        return {"x.vel": x_cmd, "y.vel": y_cmd, "theta.vel": theta_cmd}
+
+    def send_feedback(self, feedback: dict[str, Any]) -> None:
+        pass

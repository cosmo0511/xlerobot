+            "forward": "w",
+            "backward": "s",
+            "left": "a",
+            "right": "d",
+            "rotate_left": "q",
+            "rotate_right": "e",
+            "speed_up": "r",
+            "speed_down": "f",
+            "quit": "t",
+        }
+    )
+
+    # The keyboard listener is global, so anything typed anywhere reaches it.
+    # Start with the base locked and require an explicit key to enable it.
+    base_locked_on_start: bool = True
+    arm_key: str = "g"
